opt_out_usage
default_platform(:ios)

ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "10"
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

platform :ios do

  # ──────────────────────────────────────────────
  # CREDENTIALS (from trait-wallet pattern)
  # ──────────────────────────────────────────────
  app_name_prefix = "Trevo Vault"
  app_identifier_prefix = "finance.trevo.vault"

  username = "dmitry.zakharov@trevo.finance"
  team_name = "TRAIT TECH PTE LTD"
  itc_team_name = team_name

  # ──────────────────────────────────────────────
  # SHARED
  # ──────────────────────────────────────────────
  main_target = "PolkadotVault"
  dev_scheme  = "PolkadotVault-Dev"
  prod_scheme = "PolkadotVault"
  xcargs      = "-skipPackagePluginValidation -skipMacroValidation"

  # ──────────────────────────────────────────────
  # CERTIFICATES
  # ──────────────────────────────────────────────
  desc "Fetch or create certificates"
  desc "Usage: fastlane certificates"
  # ──────────────────────────────────────────────
  # CERTIFICATES
  # ──────────────────────────────────────────────
  desc "Fetch or create certificates (Development & Distribution)"
  desc "Usage: fastlane certificates"
  lane :certificates do
    # Development
    get_certificates(
      development: true,
      username: username,
      team_name: team_name,
      output_path: 'sign/',
      force: false
    )
    # Distribution
    get_certificates(
      development: false,
      username: username,
      team_name: team_name,
      output_path: 'sign/',
      force: false
    )
  end

  # ──────────────────────────────────────────────
  # REGISTER APP ID (one-time)
  # ──────────────────────────────────────────────
  desc "Register App ID in Apple Developer Portal and App Store Connect (one-time)"
  desc "Usage: fastlane register_app"
  lane :register_app do
    produce(
      username: username,
      app_identifier: app_identifier_prefix,
      app_name: app_name_prefix,
      sku: "trevo-vault-ios",
      company_name: team_name,
      itc_team_name: itc_team_name
    )
    UI.success "✅ App ID registered and app created in App Store Connect"
  end

  # ──────────────────────────────────────────────
  # PROVISIONING PROFILES
  # ──────────────────────────────────────────────
  desc "Create/fetch provisioning profiles (Development & AppStore)"
  desc "Usage: fastlane provisioning_profiles"
  lane :provisioning_profiles do
    profiles = [
      {type:'Debug', name: 'TrevoVault'},
      {type:'AppStore', name: 'TrevoVault'},
    ]
    profiles.each do |config|
      provisioning_name = config[:name] + "_" + config[:type]
      output_path = "sign/"
      filename = provisioning_name + ".mobileprovision"

      # sigh defaults: development: false, adhoc: false (which means AppStore by default)
      is_dev = config[:type] == 'Debug'

      sigh(
        development: is_dev,
        adhoc: config[:type] == 'AdHoc' ? true : nil,
        skip_install: false,
        app_identifier: app_identifier_prefix,
        username: username,
        team_name: team_name,
        provisioning_name: provisioning_name,
        output_path: output_path,
        filename: filename,
        skip_certificate_verification: true,
        platform: "ios",
        readonly: false
      )
    end
  end

  # ──────────────────────────────────────────────
  # FULL SETUP (one-time, run all steps)
  # ──────────────────────────────────────────────
  desc "Full setup: register app + certificates + provisioning (Dev & Prod)"
  desc "Usage: fastlane setup"
  lane :setup do
    register_app
    certificates
    provisioning_profiles
    UI.success "✅ Full setup complete (Dev & Prod)! You can now build for device or TestFlight."
  end

  # ──────────────────────────────────────────────
  # BUILD FOR SIMULATOR (no signing needed)
  # ──────────────────────────────────────────────
  desc "Build debug for iOS Simulator (no code signing required)"
  desc "Usage: fastlane build_simulator [device:'iPhone 16']"
  lane :build_simulator do |options|
    device = options[:device] || "iPhone 16"
    clear_derived_data

    xcodebuild(
      scheme: dev_scheme,
      configuration: "Debug",
      destination: "platform=iOS Simulator,name=#{device}",
      xcargs: "#{xcargs} CODE_SIGNING_ALLOWED=NO",
      build: true
    )

    UI.success "✅ Build succeeded for simulator: #{device}"
  end

  # ──────────────────────────────────────────────
  # BUILD FOR DEVICE (automatic signing)
  # ──────────────────────────────────────────────
  desc "Build debug for physical device using Xcode automatic signing"
  desc "Usage: fastlane build_device"
  lane :build_device do
    clear_derived_data

    update_code_signing_settings(
      use_automatic_signing: true,
      targets: [main_target],
      build_configurations: ["Debug"]
    )

    xcodebuild(
      scheme: dev_scheme,
      configuration: "Debug",
      destination: "generic/platform=iOS",
      xcargs: xcargs,
      build: true
    )

    UI.success "✅ Build succeeded for physical device"
  end

  # ──────────────────────────────────────────────
  # TESTFLIGHT DISTRIBUTION
  # ──────────────────────────────────────────────
  desc "Build and upload to TestFlight"
  desc "Usage: fastlane distribute_testflight"
  lane :distribute_testflight do
    # 1. Update provisioning profiles (ensure we have AppStore profile)
    provisioning_profiles

    # 2. Update code signing to use Manual Signing with our profile
    # Note: We use 'PolkadotVault' scheme for production
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: [main_target],
      path: "PolkadotVault.xcodeproj",
      profile_name: "TrevoVault_AppStore",
      bundle_identifier: app_identifier_prefix,
      code_sign_identity: "iPhone Distribution", # Must match cert
      build_configurations: ["Release"] # Ensure Release config uses it
    )

    # 3. Build & Archive (gym)
    gym(
      scheme: prod_scheme,
      configuration: "Release", # Assuming there is a Release config
      export_method: "app-store",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          app_identifier_prefix => "TrevoVault_AppStore"
        }
      },
      output_directory: "./fastlane-trevo/builds/",
      output_name: "TrevoVault.ipa",
      clean: true,
      xcargs: xcargs
    )

    # 4. Upload to TestFlight
    # Note: pilot uses app_identifier from Appfile
    # upload_to_testflight(
    #   skip_waiting_for_build_processing: true,
    #   apple_id: "6759246669" # App ID from App Store Connect (created previously)
    # )

    UI.success "🚀 Build complete! IPA is ready for manual upload to TestFlight."
  end


  # ──────────────────────────────────────────────
  # UNIT TESTS
  # ──────────────────────────────────────────────
  desc "Run unit tests on simulator"
  desc "Usage: fastlane unit_tests [device:'iPhone 16']"
  lane :unit_tests do |options|
    device = options[:device] || "iPhone 16"
    clear_derived_data

    scan(
      clean: true,
      scheme: dev_scheme,
      device: device,
      xcargs: xcargs,
      output_directory: "./fastlane-trevo/test_output/"
    )
  end

end
